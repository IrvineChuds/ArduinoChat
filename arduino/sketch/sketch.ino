Arduino_LED_Matrix matrix;
void (*state)();

void setup() 
{
  matrix.begin();
  matrix.setGrayscaleBits(3);
  Bridge.begin();
  Bridge.provide("set_angry_state", set_angry_state);
  Bridge.provide("set_happy_state", set_happy_state);
  Bridge.provide("set_state", set_state);
  state = &happy_state;
}

void loop() 
{
  state();
}

void set_state(char[] st) {
    // a is happy
    // b is angry
    // c is pet
    // d is sad
    // e is confused
    // f is frustrated
    // g is laugh
    // h is scared
    // i is shock
    // j is tired
    switch(st[0]) {
        case 'a':
            state = &happy_state;
            break;
        
        case 'b':
            state = &angry_state;
            break;
        
        case 'c':
            state = &pet_state;
            break;
        
        case 'd':
            state = &sad_state;
            break;
        
        case 'e':
            state = &confused_state;
            break;
        
        case 'f':
            state = &frustrated_state;
            break;
        
        case 'g': 
            state = &laugh_state;
            break;
        
        case 'h':
            state = &scared_state;
            break;
        
        case 'i':
            state = &shock_state;
            break;
        
        case 'j':
            state = &tired_state;
            break;
    }
}
void set_happy_state() {
    state = &happy_state;
}

void set_angry_state() {
    state = &angry_state;
}

void angry_state() 
{
  // LOW state means LED is ON
  matrix.draw(angry[0]);
  delay(500);
  matrix.draw(angry[1]);
  delay(500);
}

